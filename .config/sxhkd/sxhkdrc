
# Save and copy a selected screenshot.
shift + super + s
    mkdir -p "$HOME/Pictures"; i=1; while [ -e "$(printf "$HOME/Pictures/screenshot_%04d.png" "$i")" ]; do i=$((i+1)); done; file="$(printf "$HOME/Pictures/screenshot_%04d.png" "$i")"; maim -s -u "$file" && xclip -selection clipboard -t image/png -i "$file"

# Lock
super + l
    slock 

# Lock and Sleep
shift + super + l
    slock & sleep 0.5; systemctl suspend

# Full screenshot
Print
    mkdir -p "$HOME/Pictures"; i=1; while [ -e "$(printf "$HOME/Pictures/full_screen_%04d.png" "$i")" ]; do i=$((i+1)); done; file="$(printf "$HOME/Pictures/full_screen_%04d.png" "$i")"; maim -u "$file" && xclip -selection clipboard -t image/png -i "$file"
    
# Increase volume
XF86AudioRaiseVolume
    wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+

# Decrease volume
XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

# Toggle mute
XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Increase brightness
XF86MonBrightnessUp
    brightnessctl set +10%

# Decrease brightness
XF86MonBrightnessDown
    brightnessctl set 10%-

# Find mouse
F2
    find-cursor --size 320 --distance 40 --wait 400 --line-width 4 --color red
