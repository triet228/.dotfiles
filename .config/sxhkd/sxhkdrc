
# Take screenshot 
shift + super + s
    i=1; while [ -e "$(printf "$HOME/Pictures/screenshot_%04d.png" "$i")" ]; do i=$((i+1)); done; file="$(printf "$HOME/Pictures/screenshot_%04d.png" "$i")"; maim -s -u "$file" && xclip -selection clipboard -t image/png -i "$file"

# Lock
super + l
    slock 

# Lock and Sleep
shift + super + l
    slock & systemctl suspend

# Full screenshot
Print
    i=1; while [ -e "$(printf "$HOME/Pictures/full_screen_%04d.png" "$i")" ]; do i=$((i+1)); done; file="$(printf "$HOME/Pictures/full_screen_%04d.png" "$i")"; maim -u "$file" && xclip -selection clipboard -t image/png -i "$file"
    
# Increase volume
XF86AudioRaiseVolume
    pamixer -i 5

# Decrease volume
XF86AudioLowerVolume
    pamixer -d 5

# Toggle mute
XF86AudioMute
    pamixer -t

# Open dmenu
alt + p
    dmenu_run

# Increase brightness
XF86MonBrightnessUp
    brightnessctl set +10%

# Decrease brightness
XF86MonBrightnessDown
    brightnessctl set 10%-

# Find mouse
F2
    find-cursor --size 320 --distance 40 --wait 400 --line-width 4 --color red
