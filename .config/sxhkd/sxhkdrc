
# Take screenshot 
shift + super + s
    file="$HOME/Pictures/picture$(date +%Y%m%d-%H%M%S).png"; maim -s -u "$file" && xclip -selection clipboard -t image/png -i "$file"

# Lock
super + l
    slock 

# Lock and Sleep
shift + super + l
    slock & systemctl suspend

# Full screenshot
Print
    file="$HOME/Pictures/picture$(date +%Y%m%d-%H%M%S).png"; maim -u "$file" && xclip -selection clipboard -t image/png -i "$file"
    
# Increase volume
XF86AudioRaiseVolume
    pamixer -i 5

# Decrease volume
XF86AudioLowerVolume
    pamixer -d 5

# Toggle mute
XF86AudioMute
    pamixer -t

# Open dmenu
alt + p
    dmenu_run

# Increase brightness
XF86MonBrightnessUp
    brightnessctl set +10%

# Decrease brightness
XF86MonBrightnessDown
    brightnessctl set 10%-

# Find mouse
F2
    find-cursor --size 320 --distance 40 --wait 400 --line-width 4 --color red
